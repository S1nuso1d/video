PROJECT_NAME=Video Auditor — Shared Analysis Workspace
DATABASE_URL=postgresql+psycopg://video_auditor:video_auditor_dev_password@localhost:5433/video_auditor
GEMINI_API_KEY=
# Optional shared key for all team members (at least 32 characters). Leave empty for localhost-only development.
# Before exposing the app to a network, generate a random key and share it securely.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKSPACE_ACCESS_KEY=
# Optional JSON list for browser-based integration with an existing company portal.
# Example: CORS_ALLOWED_ORIGINS=["https://portal.example.com"]
CORS_ALLOWED_ORIGINS=[]
# Use Google's direct YouTube URI input (public videos); false uses Gemini Files upload.
GEMINI_YOUTUBE_DIRECT=true
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=180000
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY=1
GEMINI_RETRY_MAX_DELAY=8

# Gemini 3.8 Flash standard paid-tier rates through 2026-12-31 (USD per 1M tokens).
# Update the rate card if you change model, tier, or when Google changes its prices.
GEMINI_INPUT_PRICE_USD_PER_MILLION=0.75
GEMINI_CACHED_INPUT_PRICE_USD_PER_MILLION=0.075
GEMINI_OUTPUT_PRICE_USD_PER_MILLION=3.75
GEMINI_PRICING_VERSION=2026-11-standard-paid
# Set a current USD-to-RUB conversion rate to enable an estimated RUB amount; 0 disables it.
GEMINI_USD_TO_RUB_RATE=0

# Temporary source video acquisition. The worker removes every audit directory after processing.
YT_DLP_BINARY=yt-dlp
VIDEO_TEMP_ROOT=storage/temp
# Download the best available source video/audio; do not cap quality at 720p.
VIDEO_FORMAT=bv+ba/b
VIDEO_MAX_FILESIZE_BYTES=1500000000
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=900

# Deterministic technical metadata. Install FFmpeg/FFprobe and make ffprobe available in PATH.
FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=30
FFPROBE_REQUIRED=false

AUDIT_MAX_ATTEMPTS=2
AUDIT_RETRY_DELAY_SECONDS=30
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=120

# OpenCV frame sampling. All findings are advisory and do not change the verdict.
CV_ANALYSIS_REQUIRED=false
CV_SAMPLE_INTERVAL_SECONDS=0.5
CV_MAX_SAMPLES=1200
CV_ANALYSIS_TIMEOUT_SECONDS=120
CV_RESIZE_WIDTH=320
CV_BLACK_LUMA_THRESHOLD=16
CV_BLACK_PIXEL_RATIO=0.985
CV_BLACK_MIN_DURATION_SECONDS=0.75
CV_FREEZE_MEAN_DIFF_THRESHOLD=0.8
CV_FREEZE_CHANGED_PIXEL_RATIO=0.002
CV_FREEZE_PIXEL_DELTA=3
CV_FREEZE_MIN_DURATION_SECONDS=2.5
CV_SCENE_CHANGE_THRESHOLD=0.65
CV_BLUR_FOCUS_THRESHOLD=20
CV_BLUR_MIN_DURATION_SECONDS=1.5
CV_EVIDENCE_MAX_FRAMES=8
CV_EVIDENCE_WIDTH=240
CV_EVIDENCE_JPEG_QUALITY=45
CV_EVIDENCE_MAX_BYTES_PER_FRAME=12000

# Worker leases: heartbeat must be shorter than the lease timeout.
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=15
WORKER_LEASE_TIMEOUT_SECONDS=90
WORKER_RECOVERY_INTERVAL_SECONDS=15

GEMINI_POLL_SECONDS=5
GEMINI_MAX_WAIT_SECONDS=1800
LOG_LEVEL=INFO
