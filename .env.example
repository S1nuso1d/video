# PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql+psycopg://video_auditor:video_auditor_dev_password@localhost:5433/video_auditor

# Set this to your real key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

WORKER_POLL_SECONDS=2
STALE_JOB_MINUTES=240
GEMINI_POLL_SECONDS=5
GEMINI_MAX_WAIT_SECONDS=1800
LOG_LEVEL=INFO
